
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitações de cadastro</title>
    <link rel="stylesheet" href="/css/Admin-usuarios.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <script defer>
        window.dadosPagina = {
            usuarios: {{{json usuarios}}},
        }
    </script>
</head>
<body class="pagina-pendentes">
    <header>
        <div class="header-esquerda">
            <img src="/img/logo saliinf.png" alt="Logo do Saliinf" width="100" height="100">
            <p><span>SALIINF</span><br>DAIC - IFAM CMC</p>
        </div>

        <nav>
            <ul>
                <li><a href="#">Agenda</a></li>
                <li><a href="/admin/dashboard">Solicitações</a></li>
                <li><a class="menu">Usuários</a></li>
                <li><a href="#">Laboratórios</a></li>
                <li><a href="#">Calendário Letivo</a></li>
            </ul>
        </nav>

        <div class="header-direita">
            <p>
                Sist. de Agendamento de <br>
                Laboratórios de Informática
            </p>
            <button>Administrador</button>
        </div>
    </header>

    <main>
        <section class="container-principal">
            <h1>Usuários</h1>

            <div class="seletor">
                <div class="indicador"></div>
                <a href="/admin/usuarios" class="aba">Usuários</a>
                <a class="aba ativa">Solicitações de cadastro</a>
            </div>

            <div class="pesquisa">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" placeholder="Buscar por nome ou e-mail">
            </div>

            <div class="tabela-container">
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Data da solicitação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody id="bloco-contas"></tbody>
                </table>
            </div>
        </section>
    </main>

    <script src="/js-admin/cadastrosPendentes.js" defer></script>
</body>
</html>
